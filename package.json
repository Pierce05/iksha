{
  "name": "sach",
  "private": true,
  "type": "module",
  "scripts": {
    "test:engine": "tsx scripts/test-engine.ts",
    "fixtures:update": "UPDATE=1 tsx scripts/test-engine.ts",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build:engine && next dev",
